<?xml version="1.0" encoding="utf-8"?>
<!-- App icon foreground — graduation cap in indigo/purple gradient -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportHeight="108"
    android:viewportWidth="108">

    <!-- Graduation cap hat top (diamond/rhombus) -->
    <path
        android:pathData="M54,28 L82,43 L54,58 L26,43 Z"
        android:strokeColor="#00000000"
        android:strokeWidth="1">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="26" android:startY="28"
                android:endX="82" android:endY="58">
                <item android:color="#6366F1" android:offset="0.0"/>
                <item android:color="#9333EA" android:offset="1.0"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Graduation cap brim left -->
    <path
        android:pathData="M26,43 L26,62 Q26,66 30,68 L54,78 L54,58 Z"
        android:strokeColor="#00000000"
        android:strokeWidth="1">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="26" android:startY="43"
                android:endX="54" android:endY="78">
                <item android:color="#4F46E5" android:offset="0.0"/>
                <item android:color="#7C3AED" android:offset="1.0"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Graduation cap brim right -->
    <path
        android:pathData="M82,43 L82,62 Q82,66 78,68 L54,78 L54,58 Z"
        android:strokeColor="#00000000"
        android:strokeWidth="1">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="82" android:startY="43"
                android:endX="54" android:endY="78">
                <item android:color="#6366F1" android:offset="0.0"/>
                <item android:color="#9333EA" android:offset="1.0"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Tassel string -->
    <path
        android:fillColor="#A5B4FC"
        android:pathData="M82,43 L82,62 Q83,62 84,62 L84,43 Z" />

    <!-- Tassel ball -->
    <path
        android:fillColor="#C4B5FD"
        android:pathData="M84,62 m-4,0 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0z" />

</vector>
